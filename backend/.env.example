# Copie este arquivo para ".env" e preencha com os valores reais
# NUNCA suba o arquivo ".env" para o GitHub (ele já está no .gitignore)

PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_NAME=sigem_db
DB_USER=postgres
DB_PASSWORD=coloque_sua_senha_aqui

JWT_SECRET=troque_por_uma_string_aleatoria_qualquer
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# SMTP usado para enviar o codigo de recuperacao de senha
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario_smtp
SMTP_PASSWORD=senha_smtp
EMAIL_FROM="SIGEM <nao-responda@exemplo.com>"
RECUPERACAO_EXPIRA_MINUTOS=15
